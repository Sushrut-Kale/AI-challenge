# AGENTCRAFT — Environment Configuration Template
# Copy this file to .env.local for local development, or add these in your Vercel Project Settings > Environment Variables.

# Supabase Authentication (Optional for initial deployment, required for live team portal auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics / Deployment (Optional)
NEXT_PUBLIC_SITE_URL=https://agentcraft.vercel.app
