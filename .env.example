# ============================================================================
# AGENTCRAFT — Environment Configuration Template
# Copy this file to .env.local for local development, or configure in Vercel.
# ============================================================================

# Supabase Configuration
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (NEVER expose to client; used exclusively in server API routes & background jobs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare R2 Private Storage Configuration
# Found in: Cloudflare Dashboard > R2 Object Storage > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=agentcraft-submissions

# Application & Submission Rules
NEXT_PUBLIC_SITE_URL=https://agentcraft.vercel.app
# ISO 8601 Timestamp for the submission deadline (Round 1 cutoff)
SUBMISSION_DEADLINE=2026-10-31T23:59:59+05:30
